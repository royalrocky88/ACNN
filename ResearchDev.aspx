                <div class="acnn-rdp-lab-ph n2"><a class="acnn-rdp-ph " href="img/rd/p009_044.jpg" title="Material Synthesis Lab"><img src="img/rd/p009_044.jpg" alt="Material Synthesis Lab" loading="lazy" /></a><a class="acnn-rdp-ph  fit" href="img/rd/p009_042.jpg" title="Material Synthesis Lab"><img src="img/rd/p009_042.jpg" alt="Material Synthesis Lab" loading="lazy" /></a></div>
